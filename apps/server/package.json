{
  "name": "@wiki-agents/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WIKI_AGENTS_HOST=127.0.0.1 WIKI_AGENTS_PORT=4317 WIKI_AGENTS_DATA_DIR=${WIKI_AGENTS_DEV_DATA_DIR:-../../.data} WIKI_AGENTS_MIGRATIONS_DIR=drizzle node --conditions=source --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "record:opencode": "node --conditions=source --import tsx scripts/record-opencode.ts",
    "record:claude-code": "node --conditions=source --import tsx scripts/record-claude-code.ts",
    "record:codex": "node --conditions=source --import tsx scripts/record-codex.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@effect/platform-node": "4.1.2",
    "@opencode/client": "2.2.1",
    "@opencode/protocol": "2.2.1",
    "@opencode/schema": "2.2.1",
    "@wiki-agents/contracts": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.2",
    "github-slugger": "^2.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
