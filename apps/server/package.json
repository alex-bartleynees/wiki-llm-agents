{
  "name": "@wiki-agents/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WIKI_AGENTS_DATA_DIR=${WIKI_AGENTS_DATA_DIR:-../../.data} node --conditions=source --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@wiki-agents/contracts": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.2",
    "github-slugger": "^2.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
