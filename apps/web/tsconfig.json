{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "customConditions": ["source"]
  },
  "include": ["src", "test", "e2e", "*"],
  "exclude": ["src/service-worker"]
}
