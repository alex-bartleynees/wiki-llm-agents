{
  "name": "wiki-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "nix run .#dev",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "effect": "4.1.2",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:../../../nix/claude-agent-sdk-no-binary",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:../../../nix/claude-agent-sdk-no-binary"
  }
}
